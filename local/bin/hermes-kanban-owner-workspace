#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=../lib/owner_workspace.sh
source "$ROOT/local/lib/owner_workspace.sh"

usage() {
    cat <<'EOF'
Usage: hermes-kanban-owner-workspace <prepare|sync> --role <planner|designer|coordinator> --workspace <primary> [--dry-run]
EOF
}

[[ $# -gt 0 ]] || { usage >&2; exit 2; }
action="$1"
shift
case "$action" in prepare|sync) ;; *) usage >&2; exit 2 ;; esac

role=""
workspace=""
dry_run=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --role) role="${2:-}"; shift 2 ;;
        --workspace) workspace="${2:-}"; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

[[ -n "$role" && -n "$workspace" ]] || { usage >&2; exit 2; }
owner_workspace_prepare "$action" "$role" "$workspace" "$dry_run"
