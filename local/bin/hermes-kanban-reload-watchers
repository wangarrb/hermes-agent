#!/usr/bin/env python3
"""hermes-kanban-reload-watchers — rolling hot reload of Kanban watchers.

For each matching watcher, atomically writes a reload request JSON (mode 0600),
revalidates the lock owner PID/start-time, sends SIGUSR1, and waits for a
nonce-matched ACK (default 15s).  Processes profiles in stable sorted order;
stops on first failure and exits non-zero.

Never sends Zellij input or changes Kanban task state.

Usage:
    hermes-kanban-reload-watchers --board <board> --session <session> \
        [--profile <role>] [--ack-timeout-s 75]
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import signal
import sys
import time
from pathlib import Path
from typing import Any

# Source: <repo>/plugins/kanban/watcher_runtime.py
REPO = Path(__file__).resolve().parents[2]
KANBAN_PLUGIN = REPO / "plugins" / "kanban"
if str(KANBAN_PLUGIN) not in sys.path:
    sys.path.insert(0, str(KANBAN_PLUGIN))

from watcher_runtime import (  # type: ignore[import-not-found]
    WatcherIdentity,
    ReloadRequest,
    ReloadACK,
    runtime_root,
    write_reload_request,
    read_reload_request,
    read_reload_ack,
    delete_reload_request,
    delete_reload_handoff,
    delete_reload_ack,
    reload_request_path,
    reload_ack_path,
    _proc_start_time,
    _code_revision,
)

# Re-export for tests
__all__ = [
    "WatcherIdentity", "ReloadRequest", "ReloadACK",
    "runtime_root", "write_reload_request", "read_reload_request",
    "reload_request_path", "reload_ack_path",
    "_filter_reload_targets", "_sort_profiles", "_generate_nonce",
    "_get_runtime_root", "main",
]

# Watcher script patterns (same as supervisor)
WATCHER_PATTERNS = [
    "hermes-kanban-role-context-listener.py",
    "hermes_kanban_interactive.py",
    "deepseek_kanban_interactive.py",
    "codex_kanban_interactive.py",
    "reasonix_kanban_interactive.py",
    "claude_kanban_interactive.py",
]
WATCH_CHILD_FLAG = "--watch-child"
WATCHER_KEY_FLAGS = ("--board", "--profile", "--zellij-session", "--zellij-pane-id")
# Production Hermes watchers may sleep for up to 60 seconds between safe
# checkpoints.  Leave enough slack for scheduling and post-exec health ACK.
DEFAULT_ACK_TIMEOUT_S = 75.0


def _read_cmdline(pid: int) -> list[str] | None:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
        if not raw:
            return None
        return raw.rstrip(b"\x00").split(b"\x00")
    except (OSError, ProcessLookupError):
        return None


def _is_conda_run_wrapper(cmdline: list[str]) -> bool:
    for i, arg in enumerate(cmdline[:4]):
        if Path(arg).name == "conda":
            return i + 1 < len(cmdline) and cmdline[i + 1] == "run"
    return False


def _is_inner_python_watcher(cmdline: list[str]) -> bool:
    """Check if a cmdline is a real inner Python watcher (not a wrapper)."""
    if WATCH_CHILD_FLAG not in cmdline:
        return False
    if _is_conda_run_wrapper(cmdline):
        return False
    # Must be a Python process
    if not cmdline or "python" not in Path(cmdline[0]).name.lower():
        return False
    # Must reference a known watcher script
    arg_basenames = {Path(arg).name for arg in cmdline}
    return any(p in arg_basenames for p in WATCHER_PATTERNS)


def _watcher_key(cmdline: list[str]) -> tuple[str, ...] | None:
    values: list[str] = []
    for flag in WATCHER_KEY_FLAGS:
        try:
            idx = cmdline.index(flag)
            values.append(cmdline[idx + 1])
        except (ValueError, IndexError):
            return None
    return tuple(values)


def _get_runtime_root(rt_path: str | None = None) -> Path:
    """Get runtime root, optionally with an injected path for testing."""
    if rt_path:
        root = Path(rt_path) / "hermes-kanban" / "watchers"
        root.mkdir(parents=True, exist_ok=True)
        return root
    return runtime_root()


def _is_lock_owner(
    pid: int,
    identity_digest: str,
    rt_root: Path,
    *,
    proc_start_time: int | None = None,
) -> bool:
    """Check if a PID matches the lock metadata owner for the given identity.

    When ``proc_start_time`` is provided it must match too (PID-reuse safe).
    """
    meta_path = rt_root / identity_digest / "metadata.json"
    try:
        meta = json.loads(meta_path.read_text())
    except (OSError, json.JSONDecodeError):
        return False
    if meta.get("pid") != pid:
        return False
    if proc_start_time is not None:
        return meta.get("proc_start_time") == proc_start_time
    return True


def _filter_reload_targets(
    procs: dict[int, list[str]],
    *,
    board: str,
    session: str,
    profiles: list[str] | None,
    runtime_root_path: str | None = None,
) -> list[dict[str, Any]]:
    """Filter processes to matching watcher reload targets."""
    rt_root = _get_runtime_root(runtime_root_path)
    targets: list[dict[str, Any]] = []

    for pid, cmdline_raw in procs.items():
        cmdline = [a.decode("utf-8", errors="replace") if isinstance(a, bytes) else a for a in cmdline_raw]
        if not _is_inner_python_watcher(cmdline):
            continue

        key = _watcher_key(cmdline)
        if key is None:
            continue

        proc_board, proc_profile, proc_session, proc_pane = key
        if proc_board != board or proc_session != session:
            continue
        if profiles is not None and proc_profile not in profiles:
            continue

        ident = WatcherIdentity.from_values(proc_board, proc_profile, proc_session, proc_pane)

        # Only select the lock owner PID
        if not _is_lock_owner(pid, ident.digest, rt_root):
            continue

        targets.append({
            "pid": pid,
            "identity": ident,
            "cmdline": cmdline,
        })

    return targets


def _sort_profiles(profiles: list[str]) -> list[str]:
    return sorted(profiles)


def _generate_nonce() -> str:
    return hashlib.sha256(f"{os.getpid()}{time.time()}".encode()).hexdigest()[:32]


def _discover_watchers() -> dict[int, list[str]]:
    """Find all running processes' cmdlines."""
    result: dict[int, list[str]] = {}
    proc_dir = Path("/proc")
    for entry in proc_dir.iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid == os.getpid():
            continue
        cmdline = _read_cmdline(pid)
        if cmdline is None:
            continue
        result[pid] = [a.decode("utf-8", errors="replace") for a in cmdline]
    return result


def _wait_for_ack(
    rt_root: Path,
    identity_digest: str,
    nonce: str,
    timeout_s: float,
    pid: int,
    *,
    proc_start_time: int,
    expected_revision: str,
) -> ReloadACK | None:
    """Poll for an ACK file matching the nonce. Returns None on timeout.

    The ACK is accepted only when ALL of the following match: nonce, PID,
    proc start-time (PID-reuse safety), identity digest and code revision,
    and ``ok=True``.  A FAILED ACK (``ok=False``) is returned immediately so
    the caller can stop rolling with a distinguishable error instead of
    waiting out the timeout.
    """
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        ack = read_reload_ack(rt_root, identity_digest)
        if ack is not None and ack.nonce == nonce:
            if not ack.ok:
                return ack  # FAILED ACK — caller reports the error
            if (
                ack.pid == pid
                and ack.proc_start_time == proc_start_time
                and ack.identity_digest == identity_digest
                and ack.code_revision == expected_revision
            ):
                return ack
        time.sleep(0.3)
    return None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Rolling reload of Kanban watchers")
    parser.add_argument("--board", required=True)
    parser.add_argument("--session", required=True)
    parser.add_argument("--profile", action="append", default=None, help="Profile to reload (repeatable)")
    parser.add_argument(
        "--ack-timeout-s", type=float, default=DEFAULT_ACK_TIMEOUT_S,
        help="ACK timeout per watcher (default: 75s; covers 60s watcher poll)",
    )
    parser.add_argument("--runtime-root-path", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--proc-tree", default=None, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    rt_root = _get_runtime_root(args.runtime_root_path)

    # Discover or use injected proc tree
    if args.proc_tree:
        procs = json.loads(args.proc_tree)
        procs = {int(k): v for k, v in procs.items()}
    else:
        procs = _discover_watchers()

    targets = _filter_reload_targets(
        procs, board=args.board, session=args.session,
        profiles=args.profile, runtime_root_path=args.runtime_root_path,
    )

    if not targets:
        print("SKIPPED: no matching watchers found")
        return 0

    # Sort by profile for stable ordering
    targets.sort(key=lambda t: t["identity"].profile)

    all_ok = True
    for target in targets:
        pid = target["pid"]
        ident = target["identity"]

        # Generate nonce
        nonce = _generate_nonce()

        # Read owner PID/start-time from metadata
        meta_path = rt_root / ident.digest / "metadata.json"
        try:
            meta = json.loads(meta_path.read_text())
            owner_pid = meta.get("pid", pid)
            owner_start = meta.get("proc_start_time", 0)
        except (OSError, json.JSONDecodeError):
            print(f"FAILED: {ident.profile} — could not read lock metadata")
            all_ok = False
            break

        # Revalidate lock owner PID+start-time immediately before sending signal
        if not _is_lock_owner(
            pid, ident.digest, rt_root, proc_start_time=owner_start,
        ):
            print(f"SKIPPED: {ident.profile} — PID {pid} no longer owns lock (start-time mismatch)")
            continue

        # Verify the process is still alive
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            print(f"SKIPPED: {ident.profile} — PID {pid} not alive")
            continue

        # Write reload request atomically
        req = ReloadRequest(
            nonce=nonce,
            identity_digest=ident.digest,
            owner_pid=owner_pid,
            owner_start_time=owner_start,
            request_time=int(time.time()),
            code_revision=_code_revision(),
        )
        write_reload_request(rt_root, req)
        print(f"REQUESTED: {ident.profile} (pid={pid}, nonce={nonce[:8]}...)")

        # Send SIGUSR1
        try:
            os.kill(pid, signal.SIGUSR1)
        except ProcessLookupError:
            print(f"FAILED: {ident.profile} — PID {pid} disappeared before signal")
            delete_reload_request(rt_root, ident.digest)
            all_ok = False
            break

        # Wait for ACK (validated: nonce, PID, proc start-time, identity,
        # code revision, ok=True)
        ack = _wait_for_ack(
            rt_root, ident.digest, nonce, args.ack_timeout_s, pid,
            proc_start_time=owner_start,
            expected_revision=req.code_revision,
        )
        if ack is not None and not ack.ok:
            print(f"FAILED: {ident.profile} — watcher reported error={ack.error!r} (pid={ack.pid})")
            delete_reload_request(rt_root, ident.digest)
            delete_reload_handoff(rt_root, ident.digest)
            delete_reload_ack(rt_root, ident.digest)
            all_ok = False
            break
        if ack is None:
            print(f"FAILED: {ident.profile} — ACK timeout after {args.ack_timeout_s}s")
            delete_reload_request(rt_root, ident.digest)
            all_ok = False
            break

        print(f"ACK: {ident.profile} (pid={pid})")
        # Clean up reload state
        delete_reload_request(rt_root, ident.digest)
        delete_reload_handoff(rt_root, ident.digest)
        delete_reload_ack(rt_root, ident.digest)

    return 0 if all_ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
